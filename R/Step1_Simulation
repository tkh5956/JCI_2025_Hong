##### Step 3: Mean outcome model estimation
psi_estimation= function(iter){       # Iteration idx. iter = 1, 2, ..., num (=total number of simulation iteration)
  ### Target simulated data
  simu_data = sim_data[[iter]]
  A_1s = simu_data$A_s[[1]]; A_2s = simu_data$A_s[[2]]
  simu_data = simu_data[names(simu_data)!="A_s"]
  
  ### Removing 0 observation case
  dat = lapply(simu_data, function(x) x$Y)
  init_y = lapply(simu_data, function(x) x$init_Y)
  idx = (unlist(dat %>% map(~sum(.x[(K+1),1])))==0)
  skip_idx = which(idx==T)
  include_idx = which(idx==F)
  
  ### Target simulated data
  simu_data = sim_data[[iter]]
  
  ### Plug in nuisance function parameters
  gammas=c(estimates_c[1:3,iter],estimates_wp[1:2,iter])  # Estimates of intensity parameter gamma
  pis = estimates_c[4:6,iter]; pis_w = estimates_wp[3,iter] # Estimates of propensity parameters (in parametric model)

  df_full = dframe_gen(simu_data, category_num = K, gammas=gammas)
  
  ### Plug in predicted propensity score based on 'nonparametric' model
  df_full$pihat_gam <- df_full$pihat_wgam <- 0
  p_trj = matrix(prop_trjs[,iter]$muhat,ncol=2*L, byrow=F)
  p_trj_w = matrix(prop_trjs[,iter]$muhat_w,ncol=2*L, byrow=F)
  
  for (j in 1:(2*L)) {
    df_full$pihat_gam[as.numeric(df_full$id) %in% seq(from=(N/L/2*(j-1))+1,to =N/L/2*j)] = rep(p_trj[,j],each=K)
    df_full$pihat_wgam[as.numeric(df_full$id) %in% seq(from=(N/L/2*(j-1))+1,to =N/L/2*j)] = rep(p_trj_w[,j],each=K)
  }
  
  df_full = df_full %>% mutate(lambdat = bse, lambdat_w = bse_w)
  
  ### Plug in predicted propensity score based on 'parametric' model
  ##  > Predicted propensity from the correctly specified 'parametric' propensity model
  df_full = df_full %>% mutate(pihat_cs = exp(pis[1]+pis[2]*X+pis[3]*after_lockdown)/
                                 (1+exp(pis[1]+pis[2]*X+pis[3]*after_lockdown)))
  
  ##  > Predicted propensity from the wrongly specified 'parametric' propensity model
  df_full = df_full %>% mutate(pihat_wcs = exp(pis_w[1])/(1+exp(pis_w[1])))
  df_full = df_full %>% mutate(iafter_lockdown = if_else(after_lockdown>1/gamma[1], 1, 0 ))
  
  
  df_full$x1 = (df_full$X1+df_full$lag_A1)*(1+df_full$after_lockdown)
  df_full$x2 = (df_full$X2+df_full$lag_A2)*(1+df_full$after_lockdown)
  df_full$x3 = (df_full$X3+df_full$lag_A3)*(1+df_full$after_lockdown)
  df_full$x4 = (df_full$X4+df_full$lag_A4)*(1+df_full$after_lockdown)
  df_full = df_full %>% group_by(id, obs_t) %>% mutate(x = sum(x1, x2, x3, x4)) %>% ungroup()
