    lbd_aipwe = coef-z_prod_se_aipwe
    ubd_aipwe = coef+z_prod_se_aipwe
    
    return(list(hat_cov = diag(hat_asym_cov_aipwe), lbd = lbd_aipwe, ubd = ubd_aipwe))
