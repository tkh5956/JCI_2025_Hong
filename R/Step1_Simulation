      for ( l in 1:length(cand$lengths)) {
        if ((cand$lengths[l]>1)&(cand$values[l]==1)) {  
          # for consecutive observations in a single subject (ex: 0 0 1 1 0 0 1 0)
          ls=c(ls, rep(c(1,0),(cand$lengths[l]-1)),1)
        } else {
          # no consecutive observation (ex: 0 0 1 0 0 1 0 0 )
          ls=c(ls,cand$lengths[l])
        }
      }
      
      # combining the result
      if (cand$values[1]==1) {
        # when this subject has the first visiting time (ex: 1 0 0 1 0 0 0)
        without1 = ls[-seq(1,length(ls),2)]
        res = without1+1
        res[length(res)] = res[length(res)]-1
        res = c(1, res)
      } else {
        # if not (ex: 0 1 0 0 0 1 0 0)
        without1 = ls[-seq(2,length(ls),2)]
        res = without1+1
        res[length(res)] = res[length(res)]-1
      }
      
      return(res)
    }
    
