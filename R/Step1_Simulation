##### Step 2: Nuisance function estimation
estimation_fn = function(dat){
  ### Observation intensity model
  ss_w = coxph(Surv(tstart,tstop,endpt)~yhist_mean+A+cluster(id),data=dat,  # Wrong cox model
               control = coxph.control(timefix = F))
  ss = coxph(Surv(tstart,tstop,endpt)~yhist_mean+A*after_lockdown+cluster(id),data=dat, # Correct cox model
             control = coxph.control(timefix = F))
  
  ss2 = glm(A ~ X + after_lockdown , data=dat, family = 'binomial')  # Correct "parametric" propensity model
  ss2_w = glm(A ~ 1 , data=dat, family = 'binomial')   # Wrong "parametric" propensity model
  
  random_ids = seq(from=1, by=N/L/10, length.out=2*L*5)
  dat = dat %>% filter(id %in%  random_ids)
  dat$id = as.numeric(dat$id)
  dat = dat %>% mutate(prop_trj = if_else(id<N/L/2, 1, # Recall that there exists 10 regions
                                          if_else(id<N/L/2*2, 2, 
                                                  if_else(id<N/L/2*3, 3,
                                                          if_else(id<N/L/2*4, 4,
                                                                  if_else(id<N/L/2*5, 5,
                                                                          if_else(id<N/L/2*6, 6,
                                                                                  if_else(id<N/L/2*7, 7, 
                                                                                          if_else(id<N/L/2*8, 8,
                                                                                                  if_else(id<N/L/2*9, 9, 10))))))))))
  
  target_ids = (dat %>% group_by(prop_trj) %>% summarize(id = min(id)))$id
  dat = dat %>% filter(id %in% target_ids)
  
  prop_gam_c= function(dat) {    # Correct "nonparametric" propensity model
    varnames = c("X","after_lockdown","A")
    df = dat[,match(varnames,names(dat))]
    return(gam(A ~ s(X,after_lockdown), data=df, family=binomial())) # Correctly specified propensity
  }
  ss_prop = prop_gam_c(dat)
  dat$muhat = predict(ss_prop, dat, type="response")  # Correct prediction of propensity
  
  prop_gam_w = function(dat) {  # Wrong "nonparametric" propensity model
    varnames = c("X","after_lockdown","A")
    df = dat[,match(varnames,names(dat))]
    return(gam(A ~ 1, data=df, family=binomial())) # Wrongly specified propensity model
  }
  ss_prop = prop_gam_w(dat)
  dat$muhat_w = predict(ss_prop, dat, type="response")  # Wrong prediction of propensity
  
  trj = dat %>% dplyr::select(id, prop_trj, muhat, muhat_w)
  res = list(coef=c(ss$coefficients[-3], ss_w$coefficients, ss2$coefficients, ss2_w$coefficients),trj=trj)
  
  
  return(res)
}

