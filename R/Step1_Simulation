##### Step 1: Generate dataframe with suitable format for our main analysis with 4 categories
dframe_gen = function(simu_data, category_num, gammas){
  A_1s = simu_data$A_s[[1]]; A_2s = simu_data$A_s[[2]]
  simu_data = simu_data[names(simu_data)!="A_s"]
  
  # Removing 0 observation case
  dat = lapply(simu_data, function(x) x$Y)
  init_y = lapply(simu_data, function(x) x$init_Y)
  idx = (unlist(dat %>% map(~sum(.x[(K+1),1])))==0)
  skip_idx = which(idx==T)
  include_idx = which(idx==F)
  rmNullobs_dat = function(x) {
    lapply(1:N, function(x) if (x %in% skip_idx) 
      dat[[x]]=NULL else dat[[x]]=dat[[x]])
  }
  rmNullobs_init_y= function(x) {
    lapply(1:N, function(x) if (x %in% skip_idx) 
      init_y[[x]]=NULL else init_y[[x]]=init_y[[x]])
  }
  dat = rmNullobs_dat(dat)
  dat = dat[sapply(dat, negate(anyNA))]
  init_y = rmNullobs_init_y(init_y)
  init_y = init_y[sapply(init_y, negate(anyNA))]
  
  # Observed time for each individual & entire poulation
  obs_t = dat %>% map(~.x[(K+2),])
  whole_t = c(1:Tp)   
  
  # Observed outcomes and summation of them(for iiw)
  yti = dat %>% map(~.x[(1:K),])
  yti_full = sapply(1:length(yti), function(x)   matrix(c(init_y[[x]],yti[[x]]),nrow=K))
  yti = lapply(yti, function(x) if (!is.null(x)) as.matrix(x))
  yti_full = lapply(yti_full, function(x) if (!is.null(x)) as.matrix(x))
  y_sum_zeros_1 = lapply(yti, function(x) if (!is.null(x)) 
    as.numeric(x[1,]==0))
  y_sum_zeros_2 = lapply(yti, function(x) if (!is.null(x)) 
    as.numeric(x[2,]==0))
  y_sum_zeros_3 = lapply(yti, function(x) if (!is.null(x)) 
    as.numeric(x[3,]==0))
  y_sum_zeros_4 = lapply(yti, function(x) if (!is.null(x)) 
    as.numeric(x[4,]==0))
  y_sum_pos_1 = lapply(yti_full, function(x) if (!is.null(x)) 
    sapply(seq(ncol(x)), function(i) ifelse(sum(x[1,1:i]==0)==i,0,x[1,max(which(x[1,1:i]>0))])  )[-1])
  y_sum_pos_2 = lapply(yti_full, function(x) if (!is.null(x)) 
    sapply(seq(ncol(x)), function(i) ifelse(sum(x[2,1:i]==0)==i,0,x[2,max(which(x[2,1:i]>0))])  )[-1])
  y_sum_pos_3 = lapply(yti_full, function(x) if (!is.null(x)) 
    sapply(seq(ncol(x)), function(i) ifelse(sum(x[3,1:i]==0)==i,0,x[3,max(which(x[3,1:i]>0))])  )[-1])
  y_sum_pos_4 = lapply(yti_full, function(x) if (!is.null(x)) 
    sapply(seq(ncol(x)), function(i) ifelse(sum(x[4,1:i]==0)==i,0,x[4,max(which(x[4,1:i]>0))])  )[-1])
  
  # Outcome history function for each individual
  # Note: we use a summation of the very previous outcome over K categories
  y_hist_fn = function(i) {
    # Observed time for individual i
    obs_t_i = obs_t[[i]]
    
    # Figure out the index of observed time of individual i 
    # Among the entire observation times
    suppressWarnings({change_pt = 
      apply(X = outer(whole_t, obs_t_i, '>'), 
            MARGIN = 2, FUN = function(x) min(which(x)))})
    if (obs_t_i[length(obs_t_i)]==whole_t[length(whole_t)]) {
      # If this individual is observed at the last observation time
      change_pt[change_pt==Inf]=length(whole_t)+1
    } else {
      # If not
      change_pt[change_pt==Inf]=length(whole_t)
    }
    
    # Individual i: whether observation occurs or not is changing
    change_pt = c(1,change_pt,length(whole_t)+1)
    change_rep = diff(change_pt)
    
    # Individual i: observed time index
    obs_i_time = c(1:length(y_sum_zeros_1[[i]]))
    obs_index = c()
    for (j in 1:(length(obs_i_time))) {
      obs_index = c(obs_index, rep(0,(change_rep-1)[j]), obs_i_time[j])
    }
    if (obs_t_i[length(obs_t_i)]==whole_t[length(whole_t)]) {
      # If this individual is observed at the last visiting time point
      obs_index = c(obs_index,0)
    } else {
      # If not
      obs_index = c(obs_index, rep(0, (change_rep-1)[j+1]),0,0)
    }
    
    # History (recall that we only use (1) for our simulation)
    y_hist_pos_1 = c(rep(c(sum(init_y[[i]][1,]),y_sum_pos_1[[i]]), 
                         change_rep),y_sum_pos_1[[i]][length(y_sum_pos_1[[i]])])
    y_hist_pos_2 = c(rep(c(sum(init_y[[i]][2,]),y_sum_pos_2[[i]]), 
                         change_rep),y_sum_pos_2[[i]][length(y_sum_pos_2[[i]])])
    y_hist_pos_3 = c(rep(c(sum(init_y[[i]][3,]),y_sum_pos_3[[i]]), 
                         change_rep),y_sum_pos_3[[i]][length(y_sum_pos_3[[i]])])
    y_hist_pos_4 = c(rep(c(sum(init_y[[i]][4,]),y_sum_pos_4[[i]]), 
                         change_rep),y_sum_pos_4[[i]][length(y_sum_pos_4[[i]])])
    y_hist_zeros_1 = c(rep(c(sum(init_y[[i]][1,]==0),y_sum_zeros_1[[i]]), 
                           change_rep),y_sum_zeros_1[[i]][length(y_sum_zeros_1[[i]])])
    y_hist_zeros_2 = c(rep(c(sum(init_y[[i]][2,]==0),y_sum_zeros_2[[i]]), 
                           change_rep),y_sum_zeros_2[[i]][length(y_sum_zeros_2[[i]])])
    y_hist_zeros_3 = c(rep(c(sum(init_y[[i]][3,]==0),y_sum_zeros_3[[i]]), 
                           change_rep),y_sum_zeros_3[[i]][length(y_sum_zeros_3[[i]])])
    y_hist_zeros_4 = c(rep(c(sum(init_y[[i]][4,]==0),y_sum_zeros_4[[i]]), 
                           change_rep),y_sum_zeros_4[[i]][length(y_sum_zeros_4[[i]])])
    
    # (2) Previous outcome y
    prev_y =c(unlist(sapply(1:length(change_rep), function(x) {
      if (x==1) {prevy = rep(c(init_y[[i]]),change_rep[x])} else 
      {prevy = rep(c(yti[[i]][,(x-1)]), change_rep[x])}
      return(as.vector(prevy))
    })),as.vector(yti[[i]][,ncol(yti[[i]])]))
    
    # (2-1) Previous outcome before previous y
    pprev_y =c(unlist(sapply(1:length(change_rep), function(x) {
      if (x<=2) {prevy = rep(c(init_y[[i]]),change_rep[x])} else 
      {prevy = rep(c(yti[[i]][,(x-2)]), change_rep[x])}
      return(as.vector(prevy))
    })),as.vector(yti[[i]][,ncol(yti[[i]])]))
    
    # (3) 1st after_lockdown time (individual)
    obst = c(rep(c(0,obs_t_i), change_rep),obs_t_i[length(obs_t_i)])
    obst = as.vector(as.vector(c(whole_t,Tp)) - obst)
    
    # (3-1) 2nd after_lockdown time (individual)
    obst2 = (obst)
    
    # (4) Weighted mean past outcome y
    entire_t = as.vector(c(whole_t,Tp))
    change_pt = unique(change_pt)
    w_mean_y = c()
    for (j in (1:length(change_rep))) {
      comp_t = c(0,obs_t_i)[1:j]
      if (change_pt[j]!=length(obst)) {
        jth_target_t = entire_t[(change_pt[j]):(change_pt[j+1]-1)]
      } else {
        jth_target_t = entire_t[(change_pt[j])]
      }
      coef = 1/sapply(comp_t, function(x) jth_target_t - x)
      coef = matrix(coef, ncol=length(comp_t))
      rscoef = rowSums(coef)
      numerator = coef %*% 
        matrix(prev_y, ncol=4, byrow=T)[(change_pt[1:j]),]
      w_mean_y = c(w_mean_y,
                   as.vector(sapply(1:nrow(numerator), 
                                    function(x) numerator[x,]/rscoef[x])))
      if ((j == length(change_rep)) & 
          (change_rep[length(change_rep)]!=0)) {
        w_mean_y=c(w_mean_y, 
                   w_mean_y[((length(w_mean_y)-(K-1)):length(w_mean_y))]) 
      } 
    }
    
    return(list(y_hist_pos_1, y_hist_pos_2,y_hist_pos_3, y_hist_pos_4, obs_index, prev_y, 
                obst, w_mean_y, pprev_y, obst2, y_hist_zeros_1, y_hist_zeros_2, y_hist_zeros_3, y_hist_zeros_4))
  }
  
  # The result of y_hist_fn
  y_hist_obs = lapply(1:N, function(x) if 
                      (x %in% include_idx) y_hist_fn(x))
  y_hist_pos_1 = lapply(y_hist_obs, function(x) x[[1]])
  y_hist_pos_2 = lapply(y_hist_obs, function(x) x[[2]])
  y_hist_pos_3 = lapply(y_hist_obs, function(x) x[[3]])
  y_hist_pos_4 = lapply(y_hist_obs, function(x) x[[4]])
  y_index = lapply(y_hist_obs, function(x) x[[5]])
  y_prev = lapply(y_hist_obs, function(x) x[[6]])
  t_after_lockdown = lapply(y_hist_obs, function(x) x[[7]])
  w_mean_y = lapply(y_hist_obs, function(x) x[[8]])
  y_pprev = lapply(y_hist_obs, function(x) x[[9]])
  t_after_lockdown2 = lapply(y_hist_obs, function(x) x[[10]])
  y_hist_zeros_1 = lapply(y_hist_obs, function(x) x[[11]])
  y_hist_zeros_2 = lapply(y_hist_obs, function(x) x[[12]])
  y_hist_zeros_3 = lapply(y_hist_obs, function(x) x[[13]])
  y_hist_zeros_4 = lapply(y_hist_obs, function(x) x[[14]])
  
  # Extra function (not necessary in our simulation)
  intervals = matrix(c(0,rep(whole_t,each=2),Tp),ncol=2,byrow = T)
  tstart_stop_endpt_extract = function(index){
    endpt = rep(0,length(whole_t)+1)
    endpt[intervals[,2]%in%obs_t[[index]]]=1
    mat = cbind(intervals, endpt)
    return(mat)
  }    
  mylist = lapply(seq_along(obs_t), function(x) 
    if(x %in% include_idx) tstart_stop_endpt_extract(x))
  
  # Constructing data frame based on the preparation above
  frame_add = function(sublist,index) {
    sublist = sublist[-(Tp+1),]
    # Index will be id of each subject(assume i)
    id = index
    
    # Find out the information about individual i
    if(category_num==K) {category=seq(1:K)} else if (category_num==1) {category=1}
    
    Age = Xvar_ind[id]
    X = Xvar_LkDn
    if (id<= N1) { 
      A = A_1s[[ceiling(id/(N1/L))]]; 
    } else {
      A = A_2s[[ceiling((id-N1)/(N2/L))]];
    }  
    
    if(id<=N1) {
      lag_A=c(0,A)[-(Tp+1)]; lag_X=c(0,X)[-(Tp+1)]
    } else {
      lag_A=c(0,A)[-(Tp+1)]; lag_X=c(0,X)[-(Tp+1)]
    }
    after_lockdown = cumsum(X)/(Tp/2)
    
    yhist_pos_1 = y_hist_pos_1[[id]][-(Tp+1)]
    yhist_pos_2 = y_hist_pos_2[[id]][-(Tp+1)]
    yhist_pos_3 = y_hist_pos_3[[id]][-(Tp+1)]
    yhist_pos_4 = y_hist_pos_4[[id]][-(Tp+1)]
    yhist_zeros_1 = y_hist_zeros_1[[id]][-(Tp+1)]
    yhist_zeros_2 = y_hist_zeros_2[[id]][-(Tp+1)]
    yhist_zeros_3 = y_hist_zeros_3[[id]][-(Tp+1)]
    yhist_zeros_4 = y_hist_zeros_4[[id]][-(Tp+1)]
    
    
    y_idx = y_index[[id]][-(Tp+1)]
    if (category_num==K) {
      yprev = y_prev[[id]][seq(1,K*Tp)]
      wmean_y = w_mean_y[[id]][seq(1,K*Tp)]
      ypprev = y_pprev[[id]][seq(1,K*Tp)]
    } else {yprev <- wmean_y <- ypprev <- rep(0,Tp)}
    
    if (category_num==K) {
      y = as.vector(sapply(y_idx, function(x) { 
        if (x==0) {   # Give NA for missing outcomes
          return(rep(NA,4))
        } else {      
          return(yti[[id]][,x])}
      }
      ))
    }
    
    
    # dff: dataframe we want eventually
    dff = data.frame(id=id, category=category, Age = Age,
                     yprev = yprev, 
                     X=rep(X,each=category_num),
                     lag_X=rep(lag_X,each=category_num),
                     A=rep(A,each=category_num), 
                     lag_A=rep(lag_A,each=category_num), 
                     after_lockdown=rep(after_lockdown, each=category_num),
                     yhist_pos_1=rep(yhist_pos_1,each=category_num), 
                     yhist_pos_2=rep(yhist_pos_2,each=category_num), 
                     yhist_pos_3=rep(yhist_pos_3,each=category_num), 
                     yhist_pos_4=rep(yhist_pos_4,each=category_num), 
                     yhist_zeros_1=rep(yhist_zeros_1,each=category_num), 
                     yhist_zeros_2=rep(yhist_zeros_2,each=category_num), 
                     yhist_zeros_3=rep(yhist_zeros_3,each=category_num), 
                     yhist_zeros_4=rep(yhist_zeros_4,each=category_num), 
                     yhist_mean = rep(yhist_zeros_1+yhist_zeros_2+yhist_zeros_3+yhist_zeros_4,each=category_num)/K,
                     obs_t=rep(sublist[,2],each=category_num),
                     tstart = rep(sublist[,1],each=category_num), 
                     tstop= rep(sublist[,2],each=category_num), 
                     endpt= rep(sublist[,3],each=category_num))
    
    
    # Create indicators for each variable
    # Id
    dff$id <- factor(dff$id)
    
    # Inverse intensity weight 
    if (category_num == K) {
      dff$y = y # outcome
      dff$prev_y = yprev
      dff$after_lockdown = rep(after_lockdown,each=category_num)
      
      dff$ind_iw =(exp(gammas[1]**dff$yhist_mean+
                         gammas[2]*dff$A+
                         gammas[3]*dff$A*dff$after_lockdown))
      dff$ind_iww =(exp(gamma[4]*dff$yhist_mean+gamma[5]*dff$A))
      
      
      # Intensity weight (not inverse)
      dff$ind_iiw = 1/dff$ind_iw; dff$ind_iiww = 1/dff$ind_iww
      
      if ( K==4) {
        dff = dff %>% group_by(id, obs_t) %>% 
          dplyr::select(id, category, Age, X, lag_X, 
                        yhist_pos_1, yhist_pos_2, yhist_pos_3, yhist_pos_4,
                        yhist_zeros_1,yhist_zeros_2,yhist_zeros_3,yhist_zeros_4,yhist_mean,
                        A, lag_A, obs_t, 
                        tstart, tstop, endpt, y, 
                        prev_y, 
                        after_lockdown, ind_iw, ind_iww, ind_iiw, ind_iiww ) %>% 
          ungroup()
      }
      
      # Category
      dff$category1 <- 0
      dff$category1[dff$category==1] <- 1
      dff$category2 <- 0
      dff$category2[dff$category==2] <- 1
      dff$category3 <- 0
      dff$category3[dff$category==3] <- 1
      dff$category4 <- 0
      dff$category4[dff$category==4] <- 1
      
      # Time invariant covariate
      dff$X1 <- 0
      dff$X1[dff$category==1] <- dff$X[dff$category==1]
      dff$X2 <- 0
      dff$X2[dff$category==2] <- dff$X[dff$category==2]
      dff$X3 <- 0
      dff$X3[dff$category==3] <- dff$X[dff$category==3]
      dff$X4 <- 0
      dff$X4[dff$category==4] <- dff$X[dff$category==4]
      
      # Time invariant covariate
      dff$Age1 <- 0
      dff$Age1[dff$category==1] <- dff$Age[dff$category==1]
      dff$Age2 <- 0
      dff$Age2[dff$category==2] <- dff$Age[dff$category==2]
      dff$Age3 <- 0
      dff$Age3[dff$category==3] <- dff$Age[dff$category==3]
      dff$Age4 <- 0
      dff$Age4[dff$category==4] <- dff$Age[dff$category==4]
      
      
      dff$lag_X1 <- 0
      dff$lag_X1[dff$category==1] <- dff$lag_X[dff$category==1]
      dff$lag_X2 <- 0
      dff$lag_X2[dff$category==2] <- dff$lag_X[dff$category==2]
      dff$lag_X3 <- 0
      dff$lag_X3[dff$category==3] <- dff$lag_X[dff$category==3]
      dff$lag_X4 <- 0
      dff$lag_X4[dff$category==4] <- dff$lag_X[dff$category==4]
      
      # Treatment
      dff$A1 <- 0
      dff$A1[dff$category==1] <- dff$A[dff$category==1]
      dff$A2 <- 0
      dff$A2[dff$category==2] <- dff$A[dff$category==2]
      dff$A3 <- 0
      dff$A3[dff$category==3] <- dff$A[dff$category==3]
      dff$A4 <- 0
      dff$A4[dff$category==4] <- dff$A[dff$category==4]
      
      dff$lag_A1 <- 0
      dff$lag_A1[dff$category==1] <- dff$lag_A[dff$category==1]
      dff$lag_A2 <- 0
      dff$lag_A2[dff$category==2] <- dff$lag_A[dff$category==2]
      dff$lag_A3 <- 0
      dff$lag_A3[dff$category==3] <- dff$lag_A[dff$category==3]
      dff$lag_A4 <- 0
      dff$lag_A4[dff$category==4] <- dff$lag_A[dff$category==4]
      
      dff$after_lockdown1 <- 0
      dff$after_lockdown1[dff$category==1] <- dff$after_lockdown[dff$category==1]
      dff$after_lockdown2 <- 0
      dff$after_lockdown2[dff$category==2] <- dff$after_lockdown[dff$category==2]
      dff$after_lockdown3 <- 0
      dff$after_lockdown3[dff$category==3] <- dff$after_lockdown[dff$category==3]
      dff$after_lockdown4 <- 0
      dff$after_lockdown4[dff$category==4] <- dff$after_lockdown[dff$category==4]
      
      
      pxs = dff %>% filter(category==1, endpt==1) %>% group_by(obs_t) %>% 
        mutate(prev_x = (Age+X+lag_A+(X*(Age+lag_A))))%>%ungroup() %>% dplyr::select(prev_x)
      pxs = c(Age,pxs$prev_x)
      obs_t_i = obs_t[[id]]
      
      suppressWarnings({change_pt = 
        apply(X = outer(whole_t, obs_t_i, '>'), 
              MARGIN = 2, FUN = function(x) min(which(x)))})
      if (obs_t_i[length(obs_t_i)]==whole_t[length(whole_t)]) {
        # If this individual is observed at the last observation time
        change_pt[change_pt==Inf]=length(whole_t)+1
      } else {
        # If not
        change_pt[change_pt==Inf]=length(whole_t)
      }
      
      # Individual i: whether observation occurs or not is changing
      change_pt = c(1,change_pt,length(whole_t)+1)
      change_rep = diff(change_pt)
      
      # Individual i: observed time index
      obs_i_time = c(1:length(obs_t_i))
      obs_index = c()
      for (j in 1:(length(obs_i_time))) {
        obs_index = c(obs_index, rep(0,(change_rep-1)[j]), obs_i_time[j])
      }
      if (obs_t_i[length(obs_t_i)]==whole_t[length(whole_t)]) {
        # If this individual is observed at the last visiting time point
        obs_index = c(obs_index,0)
      } else {
        # If not
        obs_index = c(obs_index, rep(0, (change_rep-1)[j+1]),0,0)
      }
      
      px = c()
      for ( j in 1:length(pxs)) {
        px = c(px,rep(pxs[j],change_rep[j]))
      }
      dff$prev_x = rep(px,each=K)
    }
    
    return(dff)
  }
  
  # Get dataframe for every subjects with at least one observation
  dff = lapply(seq_along(mylist), function(x) if(x %in% include_idx)  
    frame_add(mylist[[x]],x))  %>% bind_rows()
  
  # Suppresing messages of dplyr
  options(dplyr.summarise.inform = FALSE)
  
  # It will be used as a new IIW for our proposed estimator
  if (category_num==K) {
    Nnow = length(levels(dff$id))
    dff$total_iiw = rep(1/(dff %>% group_by(obs_t, category) 
                           %>% summarise(sum=sum(ind_iw)))$sum,Nnow)
    dff$bse = rep((dff %>% group_by(obs_t, category) 
                   %>% summarise(sum=sum(endpt)/sum(ind_iw)))$sum,Nnow)
    dff$bse_w = rep((dff %>% group_by(obs_t, category) 
                     %>% summarise(sum=sum(endpt)/sum(ind_iww)))$sum,Nnow)
  } 
  
  return(dff)
}

