### Simulation parameters
### Basic assumption for the simulation in the manuscript:
# > There are 4 different expenditure categories
K = 4      # Number of expenditure categories (Fixed. Don't change it)
### > There are two subcontinents, consisting of N1 and N2 participants respectively
N1 <- N2 <- 100     # N1 = N2: Number of subjects in each subcontinent (for simulation, it should be a multiple of K(=4))
N = N1+N2  # Total number of subjects in data
### > For each big region, there exists 5 regions. Therefore, in total, 10 regions exist.
### > Assuming uniform distribution of participants, we have N1/5 = N2/5 subjects in each region.  
L <- 5    # Number of regions in each subcontinent (Fixed. Don't change it)
num = 1000    # Number of simulation data (num = 1000 in the manuscript simulation)
Tp = 100   # End of the research period, i.e., t = 0, 1, ..., Tp. In manuscript, it is either 100 or 200. 
sim_model = "P1"  # Simulation parameter setup. Should be either "P1" or "P2".

### Observation process parameter
gamma = c(0.075,  # gamma[1] = Baseline intensity = 0.75 (constant)
          0, 0,   # These are extra 0 in case anyone wants to add parameters in baseline intensity
                  # Currently they are all 0 (consistent with the simulation setup in the manuscript)
                   
          # Proportional intensity parameters (see simulation setup in the manuscript)
          0.5,    # gamma[4] = Intensity parameter for E_{short,i,t-}
                  #                                    ==> E_{short,i,t-}: ratio of zero expenditures across the categories
          -0.2,   # gamma[5] = Intensity parameter for A_{t}
          #                                            ==> A_{t}: Intervention at time t
          -0.2,   # gamma[6] = Intensity parameter for A_{t}*D_{LkDn,t}
          #                                            ==> D_{LkDn,t}: ratio of zero expenditures across the categories
          0, 0, 0, 0  # These are extra 0 in case anyone wants to add parameters in proportional intensity
                      # Currently they are all 0 (consistent with the simulation setup in the manuscript)
          )   

### Expenditure parameters
## Causal parameters of interest: Category-specific
if (sim_model == "P1") {
  ## (P1) in the manuscript
  theta = matrix(c(0.5, -0.5, 0.15, -0.15), nrow=1, byrow=T)  
  delta = c(-0.15, 0.15, -0.5, 0.5)
  
} else {
  ## (P2) in the manuscript
  theta = matrix(c(0.15, -0.1, 0.05, -0.20), nrow=1, byrow=T)  
  delta = c(0.2, -0.25, 0.30, -0.15)
}

## Causal parameters of interest: Modifiers shared by all categories
psi_1 <- psi_2 <- 0.35

## Non-causal parameters
# Intercepts for each category
p_int = as.matrix(log(c(0.3,0.5,0.7,0.9))) # Intercept for probability of Y_{k} > 0 at k=1, 2, 3, 4 
m_int = as.matrix(c(1,1,1,1)) # Intercept for nonzero expenditure Y at k=1, 2, 3, 4

# Extra parameters for each category (will be canceled out by model (1))
alpha_1 = c(-0.05, 0.05, -0.05, 0.02); # Intercept for probability of Y_{k} > 0 at k=1, 2, 3, 4 
alpha_2 = c(-0.05, -0.05, -0.05, -0.05)*5 # Intercept for nonzero expenditure Y at k=1, 2, 3, 4

# Combined category-specific parameters
psi=cbind(as.vector(alpha_1), as.vector(alpha_2), as.vector(theta), as.vector(delta))

# Parameter of association between expenditures across time
Tilde_rho = 0.9     

# Parameter of association between expenditures across categories
Tilde_Tau22 = matrix(0, K, K)               
Tilde_Tau22[upper.tri(Tilde_Tau22,diag=F)] = c(0.05,-0.05,0.3,
                                             0.1,0.45,0.5) 
Tilde_Tau22[lower.tri(Tilde_Tau22)] = t(Tilde_Tau22)[lower.tri(Tilde_Tau22)]
diag(Tilde_Tau22)=1; Tilde_Tau22


### Covariate generation
## Time varying covariate (e.g., lockdown) 
Xvar_LkDn <- rep(0, Tp)
lockdown_start = round(Tp/2)  # Lockdown starts from this time point
Xvar_LkDn[(lockdown_start+1):length(Xvar_LkDn)] = 1

## Individual covariate (e.g., age/100)
Xvar_ind = sample(c(18:110),N,replace=T)/100 

### Intervention A_t generation 
pi_b1 = -0.25  # Intercept
pi_b2 = 0.75   # Parameter for lockdown
pi_b3 = -0.5   # Parameter for previous treatment A_(t-1)
pi_b4 = 0      # Extra parameter in case anyone wants to add a parameter in propensity model
pi0 = c(pi_b1, pi_b2, pi_b3, pi_b4)


############################ Intervention Generator ############################

TRT_generator = function(lockdown_start) {
  A0 = 0
  # region 1: A_1
  A_1s <- A_2s <- list()
  for (j in 1:L) {
    A = A0
    A_1 = c()

    ### Logistic model
    for (i in 1:Tp) {
      Xvar = lockdown_start
      Abar = (cumsum(Xvar_LkDn)/(Tp/2))[i]
      pi_t = exp(pi_b1 + pi_b2*ifelse(i>Xvar, 1, 0 ) + pi_b3*Abar  )/
        (1+exp(pi_b1 + pi_b2*ifelse(i>Xvar, 1, 0 ) + pi_b3*Abar ))
      A = ifelse(runif(1)<pi_t, 1, 0)
      A_1 = c(A_1, A)
      
    }
    
    A_1s[[j]] = A_1
  }
  
  # region 2: A_2
  for (j in 1:L) {
    A = A0
    A_2 = c()

    for (i in 1:Tp) {
      
      Xvar = lockdown_start
      Abar = (cumsum(Xvar_LkDn)/(Tp/2))[i]
      pi_t = exp(pi_b1 + pi_b2*ifelse(i>Xvar, 1, 0 ) + pi_b3*Abar  )/
        (1+exp(pi_b1 + pi_b2*ifelse(i>Xvar, 1, 0 ) + pi_b3*Abar ))
      A = ifelse(runif(1)<pi_t, 1, 0)
      A_2 = c(A_2, A)
    }
    
    A_2s[[j]] = A_2
  }
  return(list(A_1s,A_2s))
}

############################ Observation Generator ############################# 

### Irregular observation process (depending on the past expenditure)
lambda = function(t,i,Y, Xvar, Abar, after_lockdown) {
  # Considering the mean of last expenditure 
  # only to generate h_{i}(t)
  Y_hist_zeros = as.numeric(Y[,ncol(Y)]==0)  

  # Intensity depends on both Y_hist and the covariates
  intensity = gamma[1]*exp( 
    Xvar_LkDn[t]/8+
      gamma[4]*mean(Y_hist_zeros)+     # mean(Y_hist_zeros) = E_{short,i,t-}
      gamma[5]*ifelse(t!=0,Abar[t],0) + # Abar[t] = I_{LkDn,t}
      gamma[6]*ifelse(t!=0,Abar[t],0)*after_lockdown[t]  # after_lockdown(t) = D_{LkDn,t}
    
  )
  return(intensity)
}

# Wrapper function 
lambda_wrap = function(t,i,Y,Xvar,Abar) {
  sapply(t, function(x) lambda(x,i,Y,Xvar,Abar))
}

# Non-homogeneous poisson process to generate observation process 
get_nhpp_realization <- function(t, lambda, i, Y, Xvar, Abar, after_lockdown){
  # Will sample a new time point in (last visiting time, Tp)
  t_max <- Tp
  lambda_star <- gamma[1]*exp(1/8+gamma[4])  # Maximum possible intensity
  
  # Thinning Algorithm: See Daley and Vere-Jones (2003)
  X <- numeric()
  while(length(X)==0){
    u <- runif(1)
    t <- ceiling(t - log(u)/lambda_star)
    if (t>=t_max) {
      break
    }
    if(runif(1) < lambda(t=(t), i=i, Y=Y, Xvar=Xvar, Abar=Abar, after_lockdown=after_lockdown)/lambda_star) {
      X <- c(X,t)
    }
  }
  return(list(t=X))
}

############################## Outcome Generator ############################### 

### > See B.2. in Appendix for detailed data generating algorithm
outcome_generator = function(i, A_s, num_diagonal = 3){
  A_1s = A_s[[1]]; A_2s = A_s[[2]]
  # Generate Y for all time points
  index = 1
  
  Age = Xvar_ind[i]
  Xvar = Xvar_LkDn
  # Intervention trajectories
  if (i<= N1) { 
    Abar = A_1s[[ceiling(i/(N1/L))]]
  } else {
    Abar = A_2s[[ceiling((i-N1)/(N2/L))]]
  }  
  ##### Step 0: Baseline
  ### For nonzero outcome Y and zero-inflated probability 1-p
  # Tilde_Tau22 = Desirable within-time correlation of outcome Y
  # ==> Tau22 = Necessary within-time correlation for Z (Y = exp(Z))
  
  Tilde_Tau22_m = crossprod(t(sqrt(m_int/4)))*Tilde_Tau22
  tau22 = diag(Tilde_Tau22_m)
  Tau22_m = log(Tilde_Tau22_m*tcrossprod(sqrt(exp(tau22)-1))+matrix(1, K, K))
  Tau21_m = log(Tilde_rho*Tilde_Tau22_m*tcrossprod(sqrt(exp(tau22)-1))+1)
  
  # Tilde_Tau22_p = Desirable within-time correlation of zero-inflated probability 1-p
  # ==> Tau22 = Necessary within-time correlation for Z (Y = exp(Z))
  Tilde_Tau22_p = crossprod(t(sqrt(abs(p_int)/8)))*Tilde_Tau22
  tau22 = diag(Tilde_Tau22_p)
  Tau22_p = log(Tilde_Tau22_p*tcrossprod(sqrt(exp(tau22)-1))+matrix(1, K, K))
  Tau21_p = log(Tilde_rho*Tilde_Tau22_p*tcrossprod(sqrt(exp(tau22)-1))+1)
  
  nu_new_p = as.matrix(mvrnorm(1, mu=(p_int), Sigma=Tau22_p))
  nu_new_m = as.matrix(mvrnorm(1, mu=(m_int), Sigma=Tau22_m))
  nu_p = nu_new_p
  nu_m = nu_new_m
  p_s = as.matrix(exp(nu_new_p))
  mu_s = as.matrix(nu_new_m)
  u = runif(K)
  nonzero = u < p_s  
  init_Y = as.matrix(exp(mu_s))   # Baseline Y
  
  Y = init_Y  
  init_t = NULL
  
  ##### Step 1: Initialize
  # Generate the first time point
  while (length(init_t) == 0){
    gen_t = get_nhpp_realization(t=0, lambda=lambda, i=i, Y=Y, Xvar=Xvar, Abar=Abar, after_lockdown=cumsum(Xvar)/(Tp/2))
    init_t = gen_t$t
  }
  t_s = gen_t$t  # Recording time points in this vector
  
  
  # Generation of outcome and observation time
  t = t_s[length(t_s)]
  cl_t = ceiling(t)
  
  # Initial y_hist 
  y_hist = init_Y

  zeroinf_p = function(psi, Abar, Xvar, cl_t) {
    past_A = ifelse(cl_t!=1, Abar[cl_t-1] ,0)
    cur_ldw = Xvar[cl_t]
    after_lockdown = (cumsum(Xvar)/(Tp/2))[cl_t]
    yhist_zeros = mean(as.matrix(as.numeric(y_hist[,ncol(y_hist)]==0)))
    yhist_pos = as.matrix(diag(y_hist[1:K, apply(y_hist,1,function(x) ifelse(sum(x==0)==ncol(Y),1,max(which(x>0))))]))
    return(as.matrix((p_int + psi[,1]*( cur_ldw*yhist_zeros/(1+(after_lockdown)) )+ 
                        Abar[cl_t]*( psi[,3]*(1+after_lockdown) ) )))
  }
  
  
  zeroinf_mu = function(psi, Abar, Xvar, cl_t) {
    past_A = ifelse(cl_t!=1, Abar[cl_t-1] ,0)
    cur_ldw = Xvar[cl_t]
    after_lockdown = (cumsum(Xvar)/(Tp/2))[cl_t]
    yhist_zeros = mean(as.matrix(as.numeric(y_hist[,ncol(y_hist)]==0)))
    return(as.matrix(m_int + psi[,2]*( (1+(after_lockdown))/(cur_ldw*yhist_zeros+1) )+ 
                       Abar[cl_t]*( (psi_1*cur_ldw+psi_2*yhist_zeros)+psi[,4]*(1+after_lockdown) ) ))
  }
  
  ## nu: random effect of subject i across time and category
  # Assume p_k and mu_k share the same random effect nu for simplicity
  Sigma21 = Tau21_p
  Sigma11 = Tau22_p
  if (sum(abs(Sigma11))==0) {
    Sigma_prod = Sigma11
  } else {
    Sigma11_inv = solve(Sigma11)
    Sigma_prod = Sigma21%*%Sigma11_inv
  }
  cur_p = matrix(zeroinf_p(psi, Abar, Xvar, cl_t), ncol=1)
  cond_mu_p = cur_p + Sigma_prod%*%((p_int)-(p_int))
  cond_Sigma = Sigma11 
  nu_new_p = as.matrix(mvrnorm(1, mu=(cond_mu_p), Sigma=cond_Sigma))
  
  Sigma21 = Tau21_m
  Sigma11 = Tau22_m
  Sigma11_inv = solve(Sigma11)
  Sigma_prod = Sigma21%*%Sigma11_inv
  prev_m = m_int+psi[,2]*Age
  cur_m = matrix(zeroinf_mu(psi, Abar, Xvar, cl_t), ncol=1)
  cond_mu_m = cur_m + Sigma_prod%*%(nu_new_m-prev_m)
  cond_Sigma = Sigma11 - Sigma_prod%*%t(Sigma21)
  nu_new_m = as.matrix(mvrnorm(1, mu=(cond_mu_m), Sigma=cond_Sigma))
  
  if (sum(abs(Tau22_p))==0) {
    u = rep(0,K)
  } else {
    u = runif(K)
  }
  
  nonzero = u < exp(nu_new_p)  
  
  nu_p = cbind(rep(0,K), nu_new_p)
  nu_m = cbind(nu_m, nu_new_m)
  m_p = cbind(rep(0,K), cur_p)
  m_m = cbind(prev_m, cur_m)
  
  obs_Y_it = as.matrix(exp(nu_new_m))*nonzero
  Y = cbind(c(Y,rep(0,2),p_s,mu_s), rbind(obs_Y_it,t,cl_t,exp(nu_new_p),nu_new_m))
  y_hist = cbind(y_hist, obs_Y_it)
  
  ##### Step 2: After first t 
  while (cl_t<Tp) { 
    new_gen_t = get_nhpp_realization(t=cl_t,
                                     lambda, i=i, 
                                     Y=y_hist, Xvar=Xvar, Abar=Abar, 
                                     after_lockdown = (cumsum(Xvar)/(Tp/2)) )
    if (length(new_gen_t$t)==0) {break}
    t_s = c(t_s, new_gen_t$t)
    t = t_s[length(t_s)]
    cl_t = ceiling(t)
    
    index = index + 1
    
    Sigma21 = Tau21_p
    Sigma11 = Tau22_p
    if (sum(abs(Sigma11))==0) {
      Sigma_prod = Sigma11
    } else {
      Sigma11_inv = solve(Sigma11)
      Sigma_prod = Sigma21%*%Sigma11_inv
    }
    target_nu_p = diag(nu_p[1:K,apply(y_hist,1,function(x) ifelse(sum(x==0)==ncol(Y),1,max(which(x>0))))])
    corres_prev_p = diag(m_p[1:K,apply(y_hist,1,function(x) ifelse(sum(x==0)==ncol(Y),1,max(which(x>0))))])
    prev_p = cur_p
    cur_p = matrix(zeroinf_p(psi, Abar, Xvar, cl_t), ncol=1)
    cond_mu_p = cur_p + Sigma_prod%*%(target_nu_p-corres_prev_p)
    cond_Sigma = Sigma11 - Sigma_prod%*%t(Sigma21)
    nu_new_p = as.matrix(mvrnorm(1, mu=(cond_mu_p), Sigma=cond_Sigma))
    
    Sigma21 = Tau21_m
    Sigma11 = Tau22_m
    Sigma11_inv = solve(Sigma11)
    Sigma_prod = Sigma21%*%Sigma11_inv
    target_nu_m = diag(nu_m[1:K,apply(y_hist,1,function(x) ifelse(sum(x==0)==ncol(Y),1,max(which(x>0))))])
    corres_prev_m = diag(m_m[1:K,apply(y_hist,1,function(x) ifelse(sum(x==0)==ncol(Y),1,max(which(x>0))))])
    cur_m = matrix(zeroinf_mu(psi, Abar, Xvar, cl_t), ncol=1)
    cond_mu_m = cur_m + Sigma_prod%*%(target_nu_m-corres_prev_m)
    cond_Sigma = Sigma11 - Sigma_prod%*%t(Sigma21)
    nu_new_m = as.matrix(mvrnorm(1, mu=(cond_mu_m), Sigma=cond_Sigma))
    
    nu_p = cbind(nu_p, nu_new_p)
    nu_m = cbind(nu_m, nu_new_m)
    m_p = cbind(m_p, cur_p)
    m_m = cbind(m_m, cur_m)
    t = t_s[length(t_s)]
    
    
    if (sum(abs(Tau22_p))==0) {
      u = rep(0,K)
    } else {
      u = runif(K)
    }
    nonzero = u < exp(nu_new_p)  
    obs_Y_it = as.matrix(exp(nu_new_m))*nonzero
    if (as.numeric(Y[6,ncol(Y)]) == cl_t) {}
    Y = as.matrix(cbind(Y,rbind(obs_Y_it,t,cl_t,exp(nu_new_p),(nu_new_m))),ncol=1)
    y_hist = cbind(y_hist, obs_Y_it)
    # generate next visiting time with updated Y
  }
  
  Y = Y[,-1]     # Delete the first column which contains baseline Y
  
  # For some setting of intensity function, we failed to sample Y
  # because generated t > Tp. We need to prevent this case.
  if (length(Y)==(3*K+2)) {Y=as.matrix(Y, ncol=1)} 
  rownames(Y)=c(paste0("Category ",1:K),"Real t","Ceiling t",
                paste0("p(Category ",1:K,")"),
                paste0("mu(Category ",1:K,")"))
  
  
  return(list(Y=Y, init_Y=init_Y))
}

simulator = function(iter) {
  A_s = TRT_generator(lockdown_start)
  result1 = lapply(1:N, function(x) 
    outcome_generator(x, A_s))
  result1$A_s = A_s
  return(result1)
}

