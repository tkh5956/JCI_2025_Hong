    for ( k in sort(unique(df_obs$obs_t)) ) { # for each subject i 
      # total data (including all the other's visits)
      indx = which(df_obs$obs_t == k)
      
      ttX = X_obs[indx,]   # Z_{i}(t)
      tW = ind_W[indx, indx]  # dLambda(t)
      H = tdf_obs$y[indx]*exp(-ttX %*% matrix(coef, ncol=1) * tdf_obs$A[indx])*temp_iiw_obs[indx]
      if (cor_h==T) {
        hhat_lbar_all = tdf_obs$mu_cg[indx]*temp_iiw_obs[indx]
      } else {
        hhat_lbar_all = tdf_obs$mu_wg[indx]*temp_iiw_obs[indx]
      }
      if (no_h==T) {hhat_lbar_all = rep(0, length(hhat_lbar_all))}
      ua =  Ahat_inv %*% t(ttX) %*% tW %*% (H-as.matrix(hhat_lbar_all, ncol=1))/obs_N
      sum_ua = sum_ua + tcrossprod(ua)/Tp
    }
    
    # Asymptotic covariance of beta_AIPWE  
    hat_asym_cov_aipwe = sum_ua/Tp
    
    # Wald type asymptotic 95% confidence interval of beta_AIPWE
